# KINDIX AI Knowledge Platform — environment variables
# Copy to `.env` at the repo root (gitignored) and fill in real values.
# This one file is read by both docker-compose (infra/docker-compose.yml,
# which only needs the POSTGRES_*/N8N_* vars below) and the NestJS backend
# run locally with `npm run start:dev` (which only needs the DB_*/GEMINI_*/
# LLM_PROVIDER/JWT_SECRET/EMBEDDING_SERVICE_URL vars below). It's normal for
# each process to ignore the vars it doesn't need.

# ── Docker Compose: Postgres container (infra/docker-compose.yml) ─────
# These name and authenticate the `postgres` container itself.
POSTGRES_USER=kindix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kindix

# ── Docker Compose: n8n container (infra/docker-compose.yml) ──────────
N8N_USER=admin
N8N_PASSWORD=change-me

# ── Backend -> Database connection (used by NestJS running OUTSIDE Docker) ─
# The postgres container publishes itself on the HOST as 5433 (see the
# "5433:5432" port mapping in infra/docker-compose.yml), so a backend
# started locally with `npm run start:dev` must use port 5433, not 5432.
# DB_USER/DB_PASSWORD/DB_NAME should match POSTGRES_USER/POSTGRES_PASSWORD/
# POSTGRES_DB above — they're duplicated because the backend's TypeORM
# config reads DB_* while the postgres image itself reads POSTGRES_*.
# (If/when the backend itself also runs inside docker-compose, its own
# service definition overrides these to DB_HOST=postgres/DB_PORT=5432 —
# don't change this file for that, the compose file does it.)
DB_HOST=localhost
DB_PORT=5433
DB_USER=kindix
DB_PASSWORD=change-me
DB_NAME=kindix

# ── Local BGE-M3 embedding service (knowledge-base/embedding_service.py) ──
# Only needed if the backend can't reach it on the default localhost:8001,
# e.g. once it's containerized on the docker-compose network.
EMBEDDING_SERVICE_URL=http://localhost:8001

# ── Google Gemini ────────────────────────────────────────────────────
# Used for chat/answer generation only. Embeddings run locally via BGE-M3.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# ── LLM provider selection ───────────────────────────────────────────
# Which chat LLM the RAG pipeline uses. Supported: google (Gemini).
# Must be exactly "google" — llm-provider.ts throws on anything else.
LLM_PROVIDER=google

# ── Auth ───────────────────────────────────────────────────────────
# Secret used to sign/verify JWTs. Use a long random string in real envs.
JWT_SECRET=change-me-to-a-long-random-string
