# KINDIX AI Knowledge Platform — environment variables
# Copy to `.env` (gitignored) and fill in real values.

# ── Database (PostgreSQL + pgvector) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=kindix
DB_PASSWORD=change-me
DB_NAME=kindix

# ── Google Gemini ────────────────────────────────────────────────────
# Used for chat/answer generation only. Embeddings run locally via BGE-M3.
GEMINI_API_KEY=your-gemini-api-key
