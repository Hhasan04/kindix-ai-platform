# KINDIX AI Knowledge Platform — environment variables (repo root)
# Copy to `.env` at the repo root (gitignored) and fill in real values.
#
# There are TWO separate .env files in this repo, and they're not
# interchangeable:
#   - infra/.env (see infra/.env.example) — holds POSTGRES_USER/PASSWORD/DB
#     and N8N_USER/PASSWORD. Docker Compose reads THIS file (not this one)
#     to substitute ${POSTGRES_USER} etc. in infra/docker-compose.yml,
#     because Compose's project directory defaults to wherever the compose
#     file lives.
#   - this file (repo-root .env) — holds everything the NestJS backend
#     itself needs, whether it's run locally with `npm run start:dev` or
#     inside Docker (the `backend` service in infra/docker-compose.yml loads
#     this file directly via `env_file: ../.env`).
#
# In short: infra/.env names and authenticates the containers; this file
# configures the backend application. Set up both.

# ── Backend -> Database connection ─────────────────────────────────────
# When the backend runs OUTSIDE Docker (`npm run start:dev`), it connects to
# the postgres container via its HOST-published port: DB_PORT=5433 (see the
# "5433:5432" mapping in infra/docker-compose.yml), not 5432.
# DB_USER/DB_PASSWORD/DB_NAME must match POSTGRES_USER/POSTGRES_PASSWORD/
# POSTGRES_DB in infra/.env — same credentials, different variable names
# because TypeORM reads DB_* while the postgres image reads POSTGRES_*.
# (When the backend runs INSIDE Docker instead, infra/docker-compose.yml's
# `backend` service overrides these to DB_HOST=postgres/DB_PORT=5432 itself
# — don't change this file for that case, the compose file already does it.)
DB_HOST=localhost
DB_PORT=5433
DB_USER=kindix
DB_PASSWORD=change-me
DB_NAME=kindix

# ── Local BGE-M3 embedding service (knowledge-base/embedding_service.py) ──
# Default is correct for local dev. The Docker backend service overrides
# this to http://embedding-service:8001 itself — don't change it here for
# that case either.
EMBEDDING_SERVICE_URL=http://localhost:8001

# ── Google Gemini ────────────────────────────────────────────────────
# Used for chat/answer generation only. Embeddings run locally via BGE-M3.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# ── LLM provider selection ───────────────────────────────────────────
# Which chat LLM the RAG pipeline uses. Supported: google (Gemini).
# Must be exactly "google" — llm-provider.ts throws on anything else.
LLM_PROVIDER=google

# ── Auth ───────────────────────────────────────────────────────────
# Secret used to sign/verify JWTs. Use a long random string in real envs.
JWT_SECRET=change-me-to-a-long-random-string
